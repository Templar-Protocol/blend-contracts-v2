    {
      "target": "fuzz_pool_general",
      "contracts": ["pool"],
      "entrypoints": ["submit", "submit_with_allowance", "claim", "get_config", "get_reserve_list", "get_reserve", "get_positions"]
    },
    {
      "target": "fuzz_pool_admin",
      "contracts": ["pool"],
      "entrypoints": ["propose_admin", "accept_admin", "update_pool", "queue_set_reserve", "cancel_set_reserve", "set_reserve", "update_status", "set_status", "get_admin", "get_config", "get_reserve_list", "get_reserve"]
