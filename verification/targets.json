      "group": "backstop",
      "harness": "kani_proofs::backstop::withdrawal_maturity",
      "covers": ["not_expired", "exact_maturity", "max_exact_maturity", "past_maturity", "mature_partial", "mature_exact", "mature_continue"]
    },
    {
      "group": "backstop",
      "harness": "kani_proofs::backstop::backfill_limit",
      "covers": ["no_room", "rejected_current", "exact_fill", "partial_capped_fill", "zero_request"]
    }
  ]
}
